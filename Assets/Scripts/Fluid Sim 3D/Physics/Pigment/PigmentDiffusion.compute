// PigmentDiffusion.compute
// ─────────────────────────────────────────────────────────────────────────────
// Separate compute shader for all pigment-related kernels.
// Kept in its own file so it never touches the core FluidSPH.compute.
//
// Kernels:
//   PigmentReorderKernel    — scatter pigment into sort-target using SortedIndices
//   PigmentReorderCopyBack  — overwrite live buffer from sort-target
//   PigmentDiffusionKernel  — SPH diffusion using viscosity-Laplacian kernel
// ─────────────────────────────────────────────────────────────────────────────
#pragma kernel PigmentReorderKernel
#pragma kernel PigmentReorderCopyBack
#pragma kernel PigmentDiffusionKernel

#include "UnityCG.cginc"

// ─────────────────────────────────────────────────────────────────────────────
// Shared buffers (same names / semantics as FluidSPH.compute)
// ─────────────────────────────────────────────────────────────────────────────
// IMPORTANT: Every buffer and uniform that NeighborsSearching.hlsl references
// in ANY function body — even functions this shader never calls — must be
// declared here BEFORE the #include. The HLSL compiler is single-pass and
// compiles all function bodies in the included file, not just the ones used.
// ─────────────────────────────────────────────────────────────────────────────
static const int  NumThreads = 256;
static const uint UINT_MAX   = 0xFFFFFFFF;

// ── Buffers used by NeighborsSearching.hlsl function bodies ──────────────────
// ReorderImpl / ReorderCopyBackImpl reference these even though this shader
// doesn't call those functions. They must exist for compilation to succeed.
RWStructuredBuffer<float3> _Positions;
RWStructuredBuffer<float3> _Velocities;
RWStructuredBuffer<float3> SortTarget_Positions;
RWStructuredBuffer<float3> SortTarget_PredictedPositions;
RWStructuredBuffer<float3> SortTarget_Velocities;

// ── Buffers used by this shader's own kernels ─────────────────────────────────
RWStructuredBuffer<float3> _PredictedPositions;
RWStructuredBuffer<float2> _Densities;
RWStructuredBuffer<uint>   SpatialKeys;
RWStructuredBuffer<uint>   SortedIndices;
RWStructuredBuffer<uint>   SpatialOffsets;

// ── Pigment buffers ───────────────────────────────────────────────────────────
// float4 stores linear-light RGBA pigment color per particle.
// Linear (not sRGB) so arithmetic on the GPU is physically correct.
RWStructuredBuffer<float4> _Pigments;           // live buffer (read during diffusion)
RWStructuredBuffer<float4> _PigmentsWrite;      // write target for diffusion output
RWStructuredBuffer<float4> SortTarget_Pigments; // scratch buffer for reorder

// ─────────────────────────────────────────────────────────────────────────────
// Uniforms
// ─────────────────────────────────────────────────────────────────────────────
uint  _ParticleCount;
float _SmoothingRadius;   // also used by BuildSpatialLookupImpl in the header
float _Mass;
float _DeltaTime;
float _DiffusionCoeff;

// Viscosity Laplacian kernel constant (set by FluidModel.SetSmoothingConstant)
float K_ViscosityLaplacian;

// ── CellOffsets — used by PigmentDiffusionKernel's neighborhood traversal ────
// Must be declared here; FluidSPH.compute declares its own copy in the same way.
static const int3 CellOffsets[27] =
{
    int3(-1, -1, -1), int3(0, -1, -1), int3(1, -1, -1),
    int3(-1,  0, -1), int3(0,  0, -1), int3(1,  0, -1),
    int3(-1,  1, -1), int3(0,  1, -1), int3(1,  1, -1),
    int3(-1, -1,  0), int3(0, -1,  0), int3(1, -1,  0),
    int3(-1,  0,  0), int3(0,  0,  0), int3(1,  0,  0),
    int3(-1,  1,  0), int3(0,  1,  0), int3(1,  1,  0),
    int3(-1, -1,  1), int3(0, -1,  1), int3(1, -1,  1),
    int3(-1,  0,  1), int3(0,  0,  1), int3(1,  0,  1),
    int3(-1,  1,  1), int3(0,  1,  1), int3(1,  1,  1),
};

// Reuse the neighbor-search hash/lookup helpers.
// Placed AFTER all declarations it depends on (_ParticleCount, _SmoothingRadius,
// _Positions, SortedIndices, etc.) so the single-pass compiler sees them first.
#include "../../Physics/NeighborsSearching/NeighborsSearching.hlsl"

// ─────────────────────────────────────────────────────────────────────────────
// Helpers
// ─────────────────────────────────────────────────────────────────────────────

// Viscosity Laplacian kernel W_visc  — same formula used by ViscositySolver.hlsl.
// W = (45 / (PI * h^6)) * (h - r),  for r in [0, h].
float CalculatePigmentDiffusionWeight(float dst, float h)
{
    if (dst >= h) return 0.0;
    return K_ViscosityLaplacian * (h - dst);
}

// ─────────────────────────────────────────────────────────────────────────────
// Kernel: PigmentReorderKernel
// Pigment version of the existing ReorderImpl in NeighborsSearching.hlsl.
// SortTarget_Pigments[i] = _Pigments[SortedIndices[i]]
// ─────────────────────────────────────────────────────────────────────────────
[numthreads(NumThreads, 1, 1)]
void PigmentReorderKernel(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ParticleCount) return;
    uint sortedIndex = SortedIndices[id.x];
    SortTarget_Pigments[id.x] = _Pigments[sortedIndex];
}

// ─────────────────────────────────────────────────────────────────────────────
// Kernel: PigmentReorderCopyBack
// Pigment version of ReorderCopyBackImpl.
// _Pigments[i] = SortTarget_Pigments[i]
// ─────────────────────────────────────────────────────────────────────────────
[numthreads(NumThreads, 1, 1)]
void PigmentReorderCopyBack(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ParticleCount) return;
    _Pigments[id.x] = SortTarget_Pigments[id.x];
}

// ─────────────────────────────────────────────────────────────────────────────
// Kernel: PigmentDiffusionKernel
// SPH diffusion of per-particle pigment color.
//
// Mirrors ApplyViscosity in ViscositySolver.hlsl exactly, with velocity
// replaced by the pigment color (float4).
//
// The diffusion equation (SPH discretization of ∂c/∂t = D ∇²c) reads:
//
//   dc/dt = D * sum_j [ m_j * (c_j - c_i) / rho_j * W_visc(|r_ij|, h) ]
//
// Result is written to _PigmentsWrite (double-buffered) to avoid
// read-write race conditions. FluidModel swaps the buffers after dispatch.
//
// Color mixing note:
//   Right now we diffuse in linear RGB space. This is physically correct
//   for light-based color, but real pigments mix subtractively (e.g. yellow +
//   blue = green). The structure is designed so Mixbox can replace the
//   lerp/accumulation step below without changing anything else:
//   replace the `(c_j - c_i)` accumulation with a Mixbox lerp accumulation.
// ─────────────────────────────────────────────────────────────────────────────
[numthreads(NumThreads, 1, 1)]
void PigmentDiffusionKernel(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ParticleCount) return;

    float3 position    = _PredictedPositions[id.x];
    float4 pigment     = _Pigments[id.x];
    float  density     = _Densities[id.x].x;
    float  sqrH        = _SmoothingRadius * _SmoothingRadius;

    float4 diffuseFlow = float4(0.0, 0.0, 0.0, 0.0);

    int3 centreCell = PositionToCellCoord(position, _SmoothingRadius);

    // 27-cell 3D neighborhood — identical traversal to ViscositySolver.hlsl
    [unroll]
    for (int n = 0; n < 27; n++)
    {
        int3 cell  = centreCell + CellOffsets[n];
        uint key   = GetKey(HashCell(cell), _ParticleCount);
        uint start = SpatialOffsets[key];

        if (start == UINT_MAX) continue;

        for (uint j = start; j < _ParticleCount; j++)
        {
            uint cellKey = SpatialKeys[j];
            if (cellKey != key) break;
            if (j == id.x)     continue;

            float3 otherPos = _PredictedPositions[j];
            float3 offset   = otherPos - position;
            float  sqrD     = dot(offset, offset);

            if (sqrD > sqrH) continue;

            float  dst           = sqrt(sqrD);
            float  laplacian     = CalculatePigmentDiffusionWeight(dst, _SmoothingRadius);
            float4 otherPigment  = _Pigments[j];
            float  otherDensity  = _Densities[j].x;

            // ── Additive-RGB diffusion ─────────────────────────────────────
            // This is the same formula as viscosity with color replacing velocity.
            // TO INTEGRATE MIXBOX (future):
            //   Replace this line:
            //     float4 colorDiff = otherPigment - pigment;
            //   with a Mixbox-weighted contribution that computes the
            //   subtractive mixture of pigment and otherPigment, then
            //   accumulates the delta toward that mixture color.
            float4 colorDiff = otherPigment - pigment;
            diffuseFlow += _Mass * (colorDiff / otherDensity) * laplacian;
        }
    }

    // Integrate: pigment += D * (laplacian accumulation / self-density) * dt
    float4 newPigment = pigment + (_DiffusionCoeff * diffuseFlow / density) * _DeltaTime;

    // Clamp to [0,1] per channel to keep colors in valid range.
    // Alpha is treated as pigment concentration and is also clamped.
    _PigmentsWrite[id.x] = saturate(newPigment);
}
