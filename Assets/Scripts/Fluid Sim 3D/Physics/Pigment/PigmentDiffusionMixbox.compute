// PigmentDiffusionMixbox.compute
// ─────────────────────────────────────────────────────────────────────────────
// OPTIONAL alternate to PigmentDiffusion.compute. Uses the Mixbox library
// (https://github.com/scrtwpns/mixbox) for physically-modeled pigment mixing
// (Kubelka-Munk theory) instead of the from-scratch RYB approximation.
//
// NOT used unless you explicitly opt in:
//   1. Install the package: Window > Package Manager > Add package from git URL
//        git://github.com/scrtwpns/mixbox.git#upm
//      License: CC BY-NC 4.0 — non-commercial use only unless you buy a
//      commercial license from Secret Weapons.
//   2. Assign THIS file to FluidManager3D's "Pigment Compute Shader (Mixbox)"
//      slot, assign the Mixbox LUT texture
//      ("Packages/com.scrtwpns.mixbox/Textures/MixboxLUT.png") to the
//      "Mixbox LUT" slot, and set PigmentSettings.mixingModel = Mixbox.
//
// If you don't want the external dependency, ignore this file entirely and
// use PigmentDiffusion.compute (LinearRGB / RYB modes — no library needed).
//
// Structurally this mirrors PigmentDiffusion.compute exactly (same reorder
// kernels, same SPH neighbor traversal); only the diffusion math differs:
// instead of linearly blending RGB, each neighbor's contribution is combined
// in Mixbox's latent pigment space (which IS safe to combine linearly — see
// Mixbox's own docs on mixing N colors), then converted back to RGB once.
// ─────────────────────────────────────────────────────────────────────────────
#pragma kernel PigmentReorderKernel
#pragma kernel PigmentReorderCopyBack
#pragma kernel PigmentDiffusionKernel

#include "UnityCG.cginc"

static const int  NumThreads = 256;
static const uint UINT_MAX   = 0xFFFFFFFF;

// ── Buffers used by NeighborsSearching.hlsl function bodies (unused here but
//    must exist so the single-pass compiler can see them) ────────────────────
RWStructuredBuffer<float3> _Positions;
RWStructuredBuffer<float3> _Velocities;
RWStructuredBuffer<float3> SortTarget_Positions;
RWStructuredBuffer<float3> SortTarget_PredictedPositions;
RWStructuredBuffer<float3> SortTarget_Velocities;

// ── Buffers used by this shader's own kernels ─────────────────────────────────
RWStructuredBuffer<float3> _PredictedPositions;
RWStructuredBuffer<float2> _Densities;
RWStructuredBuffer<uint>   SpatialKeys;
RWStructuredBuffer<uint>   SortedIndices;
RWStructuredBuffer<uint>   SpatialOffsets;

// ── Pigment buffers — plain linear RGBA in this mode (Mixbox converts
//    to/from latent space internally each step, so nothing else needs to
//    know about latent space at all) ──────────────────────────────────────
RWStructuredBuffer<float4> _Pigments;
RWStructuredBuffer<float4> _PigmentsWrite;
RWStructuredBuffer<float4> SortTarget_Pigments;

uint  _ParticleCount;
float _SmoothingRadius;
float _Mass;
float _DeltaTime;
float _DiffusionCoeff;
float K_ViscosityLaplacian;

static const int3 CellOffsets[27] =
{
    int3(-1, -1, -1), int3(0, -1, -1), int3(1, -1, -1),
    int3(-1,  0, -1), int3(0,  0, -1), int3(1,  0, -1),
    int3(-1,  1, -1), int3(0,  1, -1), int3(1,  1, -1),
    int3(-1, -1,  0), int3(0, -1,  0), int3(1, -1,  0),
    int3(-1,  0,  0), int3(0,  0,  0), int3(1,  0,  0),
    int3(-1,  1,  0), int3(0,  1,  0), int3(1,  1,  0),
    int3(-1, -1,  1), int3(0, -1,  1), int3(1, -1,  1),
    int3(-1,  0,  1), int3(0,  0,  1), int3(1,  0,  1),
    int3(-1,  1,  1), int3(0,  1,  1), int3(1,  1,  1),
};

#include "../../Physics/NeighborsSearching/NeighborsSearching.hlsl"

// ── Mixbox setup — texture/sampler + LUT macro MUST be declared before the
//    #include, per Mixbox's own shader integration docs ─────────────────────
Texture2D _MixboxLUT;
SamplerState sampler_MixboxLUT;
#define MIXBOX_LUT(uv) _MixboxLUT.SampleLevel(sampler_MixboxLUT, uv, 0)
#include "../../Mixbox/Mixbox.hlsl"

float CalculatePigmentDiffusionWeight(float dst, float h)
{
    if (dst >= h) return 0.0;
    return K_ViscosityLaplacian * (h - dst);
}

[numthreads(NumThreads, 1, 1)]
void PigmentReorderKernel(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ParticleCount) return;
    uint sortedIndex = SortedIndices[id.x];
    SortTarget_Pigments[id.x] = _Pigments[sortedIndex];
}

[numthreads(NumThreads, 1, 1)]
void PigmentReorderCopyBack(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ParticleCount) return;
    _Pigments[id.x] = SortTarget_Pigments[id.x];
}

[numthreads(NumThreads, 1, 1)]
void PigmentDiffusionKernel(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ParticleCount) return;

    float3 position = _PredictedPositions[id.x];
    float4 pigment  = _Pigments[id.x];
    float  density  = _Densities[id.x].x;
    float  sqrH     = _SmoothingRadius * _SmoothingRadius;

    MixboxLatent selfLatent = MixboxRGBToLatent(pigment.rgb);
    MixboxLatent flow       = selfLatent - selfLatent; // zero, regardless of underlying type
    float alphaFlow          = 0.0;

    int3 centreCell = PositionToCellCoord(position, _SmoothingRadius);

    [unroll]
    for (int n = 0; n < 27; n++)
    {
        int3 cell  = centreCell + CellOffsets[n];
        uint key   = GetKey(HashCell(cell), _ParticleCount);
        uint start = SpatialOffsets[key];
        if (start == UINT_MAX) continue;

        for (uint j = start; j < _ParticleCount; j++)
        {
            uint cellKey = SpatialKeys[j];
            if (cellKey != key) break;
            if (j == id.x) continue;

            float3 otherPos = _PredictedPositions[j];
            float3 offset   = otherPos - position;
            float  sqrD     = dot(offset, offset);
            if (sqrD > sqrH) continue;

            float  dst          = sqrt(sqrD);
            float  laplacian    = CalculatePigmentDiffusionWeight(dst, _SmoothingRadius);
            float4 otherPigment = _Pigments[j];
            float  otherDensity = _Densities[j].x;
            float  w            = _Mass * laplacian / otherDensity;

            MixboxLatent otherLatent = MixboxRGBToLatent(otherPigment.rgb);
            flow      += w * (otherLatent - selfLatent);
            alphaFlow += w * (otherPigment.a - pigment.a);
        }
    }

    MixboxLatent newLatent = selfLatent + (_DiffusionCoeff * flow / density) * _DeltaTime;
    float3 newRGB   = MixboxLatentToRGB(newLatent);
    float  newAlpha = saturate(pigment.a + (_DiffusionCoeff * alphaFlow / density) * _DeltaTime);

    _PigmentsWrite[id.x] = float4(saturate(newRGB), newAlpha);
}
