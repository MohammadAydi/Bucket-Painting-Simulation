#pragma kernel GravityForce
#pragma kernel PositionPredictor
#pragma kernel BuildSpatialLookup 
#pragma kernel Reorder 
#pragma kernel ReorderCopyBack 
#pragma kernel DensityCalculator 
#pragma kernel WCSPressureSolver
#pragma kernel NearPressureSolver
#pragma kernel StandardViscositySolver 
#pragma kernel StandardSurfaceTension 
#pragma kernel Integrator
#pragma kernel CanvasCollision
#pragma kernel FrictionForce

#include "UnityCG.cginc" 
#include "FluidMath.hlsl" 

static const int NumThreads = 256; 
static const uint UINT_MAX = 0xFFFFFFFF; 

// ─────────────────────────────────────────────────────────────
// Buffers & Variables
// ─────────────────────────────────────────────────────────────
RWStructuredBuffer<float3> _Positions; 
RWStructuredBuffer<float3> _PredictedPositions; 
RWStructuredBuffer<float3> _Velocities; 
RWStructuredBuffer<float2> _Densities; 
RWStructuredBuffer<uint> SpatialKeys; 
RWStructuredBuffer<uint> SortedIndices; 
RWStructuredBuffer<uint> SpatialOffsets; 

RWStructuredBuffer<float3> SortTarget_Positions; 
RWStructuredBuffer<float3> SortTarget_PredictedPositions; 
RWStructuredBuffer<float3> SortTarget_Velocities; 

RWStructuredBuffer<float> _debugBuffer;

uint _ParticleCount; 
float _DeltaTime; 
float _Mass; 
float _Gravity; 
float _SmoothingRadius; 
float _PressureMultiplier; 
float _TargetDensity; 
float _ParticleRadius; 
float _CollisionDamping; 
float _NearPressureMultiplier; 

float3 _BoundaryLocalMin; 
float3 _BoundaryLocalMax; 
float4x4 _BoundaryWorldToLocal; 
float4x4 _BoundaryLocalToWorld; 

float3 _InteractionInputPos; 
float _InteractionRadius; 
float _InteractionStrength; 

float _ViscosityCoeff; 
float _SurfaceTensionCoeff; 
float _SurfaceTensionThreshold; 

// ===== Canvas plane uniforms =====
// The canvas is a finite, arbitrarily transformed plane (a stretched quad).
// We describe it with a center point, a unit normal, and two unit in-plane
// axes (tangent/bitangent) plus half-extents along those axes.
float3 _CanvasCenter;
float3 _CanvasNormal;     // unit, points away from the "front" paintable face
float3 _CanvasTangent;    // unit, in-plane axis (local X)
float3 _CanvasBitangent;  // unit, in-plane axis (local Y), = cross(normal, tangent)
float2 _CanvasHalfExtents; // half-width along tangent, half-height along bitangent

float _CanvasFrictionCoeff;   // delta in formula (8), controls falloff distance
float _CanvasCollisionDamping;

float4x4 _CanvasWorldToLocal;
float4x4 _CanvasLocalToWorld;



static const int3 CellOffsets[27] =
{
    int3(-1, -1, -1), int3(0, -1, -1), int3(1, -1, -1),
    int3(-1, 0, -1), int3(0, 0, -1), int3(1, 0, -1),
    int3(-1, 1, -1), int3(0, 1, -1), int3(1, 1, -1),
    int3(-1, -1, 0), int3(0, -1, 0), int3(1, -1, 0),
    int3(-1, 0, 0), int3(0, 0, 0), int3(1, 0, 0),
    int3(-1, 1, 0), int3(0, 1, 0), int3(1, 1, 0),
    int3(-1, -1, 1), int3(0, -1, 1), int3(1, -1, 1),
    int3(-1, 0, 1), int3(0, 0, 1), int3(1, 0, 1),
    int3(-1, 1, 1), int3(0, 1, 1), int3(1, 1, 1)
};

// ─────────────────────────────────────────────────────────────
// Module Includes
// ─────────────────────────────────────────────────────────────
#include "../Physics/Gravity/GravityForce.hlsl"
#include "../Physics/PositionPredictor/PositionPredictor.hlsl"
#include "../Physics/NeighborsSearching/NeighborsSearching.hlsl"
#include "../Physics/Density/DensityCalc.hlsl"
#include "../Physics/Pressure/PressureSolver.hlsl"
#include "../Physics/Viscosity/ViscositySolver.hlsl"
#include "../Physics/SurfaceTension/SurfaceTensionSolver.hlsl"
#include "../Physics/Integrator//Integrate.hlsl"
#include "../Physics/Canvas/CanvasMath.hlsl"
#include "../Physics/Canvas/CanvasCollision.hlsl"
#include "../Physics/Canvas/FrictionSolver.hlsl"

// ─────────────────────────────────────────────────────────────
// Kernel Definitions
// ─────────────────────────────────────────────────────────────
[numthreads(NumThreads, 1, 1)]
void GravityForce(uint3 id : SV_DispatchThreadID) { ApplyGravity(id); }

[numthreads(NumThreads, 1, 1)]
void PositionPredictor(uint3 id : SV_DispatchThreadID) { PredictPositions(id); }

[numthreads(NumThreads, 1, 1)]
void BuildSpatialLookup(uint3 id : SV_DispatchThreadID) { BuildSpatialLookupImpl(id); }

[numthreads(NumThreads, 1, 1)]
void Reorder(uint3 id : SV_DispatchThreadID) { ReorderImpl(id); }

[numthreads(NumThreads, 1, 1)]
void ReorderCopyBack(uint3 id : SV_DispatchThreadID) { ReorderCopyBackImpl(id); }

[numthreads(NumThreads, 1, 1)]
void DensityCalculator(uint3 id : SV_DispatchThreadID) { CalculateDensity(id); }

[numthreads(NumThreads, 1, 1)]
void WCSPressureSolver(uint3 id : SV_DispatchThreadID) { ApplyWCSPressure(id); }

[numthreads(NumThreads, 1, 1)]
void NearPressureSolver(uint3 id : SV_DispatchThreadID) { ApplyNearPressure(id); }

[numthreads(NumThreads, 1, 1)]
void StandardViscositySolver(uint3 id : SV_DispatchThreadID) { ApplyViscosity(id); }

[numthreads(NumThreads, 1, 1)]
void StandardSurfaceTension(uint3 id : SV_DispatchThreadID) { ApplySurfaceTension(id); }

[numthreads(NumThreads, 1, 1)]
void CanvasCollision(uint3 id : SV_DispatchThreadID) { ResolveCanvasCollision(id); }
[numthreads(NumThreads, 1, 1)]
void FrictionForce(uint3 id : SV_DispatchThreadID) { ApplyCanvasFriction(id); }

[numthreads(NumThreads, 1, 1)]
void Integrator(uint3 id : SV_DispatchThreadID) { ApplyIntegration(id); }