#pragma kernel UpdateDensities
#pragma kernel CalculatePressureForces
#pragma kernel Integrate

#include "UnityCG.cginc"

static const int NumThreads = 64;

struct ParticleData
{
    float4 position;
    float4 velocity;
    float4 force;
    float density;
    float pressure;
};

RWStructuredBuffer<ParticleData> _Particles;

int _ParticleCount;
float _DeltaTime;
float _Mass;
float _SmoothingRadius;
float _PressureMultiplier;
float _TargetDensity;
float _ParticleRadius;
float _CollisionDamping;
float3 _BoundaryLocalMin;
float3 _BoundaryLocalMax;
float4x4 _BoundaryWorldToLocal;
float4x4 _BoundaryLocalToWorld;

float SmoothingKernel(float radius, float dst)
{
    if (dst >= radius)
        return 0.0;

    float diff = radius * radius - dst * dst;
    float volume = 315.0 / (64.0 * UNITY_PI * pow(radius, 9));
    return diff * diff * diff * volume;
}

float SmoothingKernelDerivative(float dst, float radius)
{
    if (dst >= radius)
        return 0.0;

    float diff = radius - dst;
    float scale = -45.0 / (UNITY_PI * pow(radius, 6));
    return diff * diff * scale;
}

float DensityToPressure(float density)
{
    float densityError = density - _TargetDensity;
    return densityError * _PressureMultiplier;
}

[numthreads(NumThreads, 1, 1)]
void UpdateDensities(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ParticleCount)
        return;

    ParticleData particle = _Particles[id.x];
    float density = 0.0;

    for (int i = 0; i < _ParticleCount; i++)
    {
        float dst = distance(_Particles[i].position.xyz, particle.position.xyz);
        density += _Mass * SmoothingKernel(_SmoothingRadius, dst);
    }

    particle.density = density;
    particle.pressure = DensityToPressure(density);
    particle.force = float4(0.0, 0.0, 0.0, 0.0);
    _Particles[id.x] = particle;
}

[numthreads(NumThreads, 1, 1)]
void CalculatePressureForces(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ParticleCount)
        return;

    ParticleData particle = _Particles[id.x];
    float3 pressureForce = float3(0.0, 0.0, 0.0);

    for (int i = 0; i < _ParticleCount; i++)
    {
        if (i == id.x)
            continue;

        ParticleData other = _Particles[i];
        float3 offset = other.position.xyz - particle.position.xyz;
        float dst = length(offset);
        float3 dir = dst > 0.0 ? offset / dst : float3(0.0, 0.0, 0.0);
        float slope = SmoothingKernelDerivative(dst, _SmoothingRadius);
        float sharedPressure = (particle.pressure + other.pressure) * 0.5;
        float density = max(other.density, 0.0001);

        pressureForce += dir * (sharedPressure * slope * _Mass) / density;
    }

    particle.force = float4(pressureForce, 0.0);;
    _Particles[id.x] = particle;
}

[numthreads(NumThreads, 1, 1)]
void Integrate(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ParticleCount)
        return;

    ParticleData particle = _Particles[id.x];
    float density = max(particle.density, 0.0001);

    particle.velocity.xyz += (particle.force.xyz / density) * _DeltaTime;
    particle.position.xyz += particle.velocity.xyz * _DeltaTime;

    float3 positionLocal = mul(_BoundaryWorldToLocal, float4(particle.position.xyz, 1.0)).xyz;
    float3 velocityLocal = mul((float3x3)_BoundaryWorldToLocal, particle.velocity.xyz);
    float3 minBound = _BoundaryLocalMin + _ParticleRadius;
    float3 maxBound = _BoundaryLocalMax - _ParticleRadius;

    if (positionLocal.x < minBound.x)
    {
        positionLocal.x = minBound.x;
        velocityLocal.x *= -_CollisionDamping;
    }
    else if (positionLocal.x > maxBound.x)
    {
        positionLocal.x = maxBound.x;
        velocityLocal.x *= -_CollisionDamping;
    }

    if (positionLocal.y < minBound.y)
    {
        positionLocal.y = minBound.y;
        velocityLocal.y *= -_CollisionDamping;
    }
    else if (positionLocal.y > maxBound.y)
    {
        positionLocal.y = maxBound.y;
        velocityLocal.y *= -_CollisionDamping;
    }

    if (positionLocal.z < minBound.z)
    {
        positionLocal.z = minBound.z;
        velocityLocal.z *= -_CollisionDamping;
    }
    else if (positionLocal.z > maxBound.z)
    {
        positionLocal.z = maxBound.z;
        velocityLocal.z *= -_CollisionDamping;
    }

    particle.position.xyz = mul(_BoundaryLocalToWorld, float4(positionLocal, 1.0)).xyz;
    particle.velocity.xyz = mul((float3x3)_BoundaryLocalToWorld, velocityLocal);

    _Particles[id.x] = particle;
}