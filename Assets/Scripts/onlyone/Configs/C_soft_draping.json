  "startThetaDot": 0.0, "startPhiDot": 180.0, "pivotFriction": 0.02,

  "segments": 30, "ropeLength": 1.34, "ropeWidth": 0.024, "linearDensity": 0.25,
  "substeps": 4, "constraintIterations": 10,
  "compliance": 0.00002,
  "internalDampingRate": 0.25,
  "stretchLimit": 1.1,
  "enableBending": true, "bendingStiffness": 0.008,
  "wind": {"x":0,"y":0,"z":0}, "dynamicBucket": true,

  "enableTorsion": true, "initialTurns": 0.0,
  "torsionalStiffness": 20.0, "dampingRatio": 0.15,
  "torsionRadius": 0.012, "torsionIterations": 8,
  "clampPivotTwist": true, "maxTwistRate": 400.0
