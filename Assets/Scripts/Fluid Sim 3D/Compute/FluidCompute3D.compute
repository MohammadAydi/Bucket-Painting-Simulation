[numthreads(NumThreads, 1, 1)]
void BuildSpatialLookup(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ParticleCount) return;
    
    uint index = id.x;
    int3 cell = PositionToCellCoord(_Positions[index], _SmoothingRadius);
    uint hash = HashCell(cell);
    uint key = GetKey(hash, _ParticleCount);
    SpatialKeys[id.x] = key;
}

[numthreads(NumThreads, 1, 1)]
void UpdateDensities(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ParticleCount) return;

    float3 pos = _Positions[id.x].xyz;
    float sqrH = _SmoothingRadius * _SmoothingRadius;
    float density = 0.0;
    float nearDensity = 0.0;

    int3 centreCell = PositionToCellCoord(pos, _SmoothingRadius);
    
    [unroll]
    for (int n = 0; n < 27; n++)
    {
        int3 cell = centreCell + CellOffsets[n];
        uint key = GetKey(HashCell(cell), _ParticleCount);
        uint start = SpatialOffsets[key];

        if (start == UINT_MAX) continue;
        
        for (uint j = start; j < _ParticleCount; j++)
        {
            uint cellKey = SpatialKeys[j];
            if (cellKey != key) break;
            
            float3 other = _Positions[j].xyz;
            float3 delta = other - pos;
            float sqrD = dot(delta, delta);
            
            if (sqrD <= sqrH)
            {
                float dst = sqrt(sqrD);
                density += _Mass * CalculateDensityWeight(dst, _SmoothingRadius);

                // Near density is only needed by PRESSURE_MODE_NEAR_PRESSURE.
                // This is a uniform branch (same for every thread in the dispatch,
                // since _PressureSolverMode is a single global setting), so it costs
                // nothing extra in Standard mode and doesn't cause warp divergence.
                if (_PressureSolverMode == PRESSURE_MODE_NEAR_PRESSURE)
                {
                    nearDensity += _Mass * CalculateNearDensityWeight(dst, _SmoothingRadius);
                }
            }
        }
    }
    _Densities[id.x] = float2(density, nearDensity);
}

[numthreads(NumThreads, 1, 1)]
void CalculatePressureForces(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ParticleCount) return;
    
    float3 position = _Positions[id.x].xyz;
    float3 velocity = _Velocities[id.x].xyz;

    float2 selfDensities = _Densities[id.x];
    float density = selfDensities.x;
    float pressure = DensityToPressure(density, _TargetDensity, _PressureMultiplier);

    // Only meaningful when _PressureSolverMode == PRESSURE_MODE_NEAR_PRESSURE
    // (selfDensities.y is left at 0 by UpdateDensities otherwise, which is fine
    // since NearDensityToPressure(0, ...) == 0).
    float nearDensity = selfDensities.y;
    float nearPressure = NearDensityToPressure(nearDensity, _NearPressureMultiplier);
    
    float3 pressForce = float3(0.0, 0.0, 0.0);
    float sqrH = _SmoothingRadius * _SmoothingRadius;
    int3 centreCell = PositionToCellCoord(position, _SmoothingRadius);
    
    [unroll]
    for (int n = 0; n < 27; n++)
    {
        int3 cell = centreCell + CellOffsets[n];
        uint key = GetKey(HashCell(cell), _ParticleCount);
        uint start = SpatialOffsets[key];

        if (start == UINT_MAX) continue;
        
        for (uint j = start; j < _ParticleCount; j++)
        {
            uint cellKey = SpatialKeys[j];
            if (cellKey != key) break;
            
            uint other_idx = j;
            if (other_idx == id.x) continue;
            
            float3 otherPosition = _Positions[other_idx].xyz;
            float3 offset = otherPosition - position;
            float sqrD = dot(offset, offset);
            
            if (sqrD > sqrH) continue;
            
            float dst = sqrt(sqrD);
            float3 dir = (dst > 0.0) ? (offset / dst) : float3(0.0, 1.0, 0.0);

            float2 otherDensities = _Densities[other_idx];
            float otherDensity = otherDensities.x;
            float otherPressure = DensityToPressure(otherDensity, _TargetDensity, _PressureMultiplier);

            // ── Pressure solver dispatch ────────────────────────────────────
            // Add new modes here: one case per PRESSURE_MODE_* in FluidMath.hlsl,
            // calling its own Compute*PressureForce() contribution function.
            switch (_PressureSolverMode)
            {
                case PRESSURE_MODE_NEAR_PRESSURE:
                {
                    pressForce += ComputeStandardPressureForce(dst, dir, pressure, otherDensity, otherPressure, _SmoothingRadius, _Mass);

                    float otherNearDensity = otherDensities.y;
                    float otherNearPressure = NearDensityToPressure(otherNearDensity, _NearPressureMultiplier);
                    pressForce += ComputeNearPressureForce(dst, dir, nearPressure, otherNearDensity, otherNearPressure, _SmoothingRadius, _Mass);
                    break;
                }
                case PRESSURE_MODE_STANDARD:
                default:
                {
                    pressForce += ComputeStandardPressureForce(dst, dir, pressure, otherDensity, otherPressure, _SmoothingRadius, _Mass);
                    break;
                }
            }
        }
    }

    velocity += (pressForce / density) * _DeltaTime;
    _Velocities[id.x] = velocity;
}

// ─────────────────────────────────────────────────────────────
// DFSPH: Divergence-Free Solver (Bender & Koschier 2017, Sec. 3.2)
// ─────────────────────────────────────────────────────────────

// Algorithm 1, lines 19-20 (the alpha_i half): computes the per-particle factor
// alpha_i (Eq. 11) once per simulation step, right after densities are updated.
// alpha_i only depends on current positions, so it is reused unchanged by every
// Jacobi iteration of JacobiDivergenceStep below — this is the whole point of
// factoring it out per the paper (avoids recomputing the neighbour sums per iteration).
[numthreads(NumThreads, 1, 1)]
void ComputeAlpha(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ParticleCount) return;

    float3 position = _Positions[id.x].xyz;
    float density = _Densities[id.x].x;

    float3 sumGradW = float3(0.0, 0.0, 0.0); // sum_j m_j grad(W_ij)
    float sumSqGradW = 0.0;                   // sum_j |m_j grad(W_ij)|^2

    float sqrH = _SmoothingRadius * _SmoothingRadius;
    int3 centreCell = PositionToCellCoord(position, _SmoothingRadius);

    [unroll]
    for (int n = 0; n < 27; n++)
    {
        int3 cell = centreCell + CellOffsets[n];
        uint key = GetKey(HashCell(cell), _ParticleCount);
        uint start = SpatialOffsets[key];

        if (start == UINT_MAX) continue;

        for (uint j = start; j < _ParticleCount; j++)
        {
            uint cellKey = SpatialKeys[j];
            if (cellKey != key) break;
            if (j == id.x) continue;

            float3 otherPosition = _Positions[j].xyz;
            float3 offset = otherPosition - position;
            float sqrD = dot(offset, offset);

            if (sqrD > sqrH) continue;

            float dst = sqrt(sqrD);
            float3 dir = (dst > 0.0) ? (offset / dst) : float3(0.0, 1.0, 0.0);

            float3 gradW = _Mass * DFSPH_GradW(dst, dir, _SmoothingRadius);
            sumGradW += gradW;
            sumSqGradW += dot(gradW, gradW);
        }
    }

    _Alphas[id.x] = DFSPH_FinalizeAlpha(density, sumGradW, sumSqGradW);
}

// Algorithm 2, line 4: Drho_i/Dt (Eq. 9) from the current v* snapshot, then
// line 6's kappa_i, written to _Kappas. This is pass 1 of a Jacobi iteration.
// Split out as its own kernel (rather than fused with the correction pass)
// so kappa_j is an O(1) buffer read in pass 2 below, instead of a second nested
// neighbour loop — that fused version is O(N * k^2) per iteration and is not
// something you want on real particle counts.
[numthreads(NumThreads, 1, 1)]
void ComputeDivergenceKappa(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ParticleCount) return;

    float3 position = _Positions[id.x].xyz;
    float3 velocity_i = _VelocitiesReadDF[id.x];
    float alpha_i = _Alphas[id.x];

    float sqrH = _SmoothingRadius * _SmoothingRadius;
    int3 centreCell = PositionToCellCoord(position, _SmoothingRadius);

    float divergence = 0.0; // Drho_i/Dt

    [unroll]
    for (int n = 0; n < 27; n++)
    {
        int3 cell = centreCell + CellOffsets[n];
        uint key = GetKey(HashCell(cell), _ParticleCount);
        uint start = SpatialOffsets[key];

        if (start == UINT_MAX) continue;

        for (uint j = start; j < _ParticleCount; j++)
        {
            uint cellKey = SpatialKeys[j];
            if (cellKey != key) break;
            if (j == id.x) continue;

            float3 otherPosition = _Positions[j].xyz;
            float3 offset = otherPosition - position;
            float sqrD = dot(offset, offset);

            if (sqrD > sqrH) continue;

            float dst = sqrt(sqrD);
            float3 dir = (dst > 0.0) ? (offset / dst) : float3(0.0, 1.0, 0.0);
            float3 gradW = DFSPH_GradW(dst, dir, _SmoothingRadius);

            float3 velocity_j = _VelocitiesReadDF[j];
            divergence += _Mass * dot(velocity_i - velocity_j, gradW);
        }
    }

    _Kappas[id.x] = (divergence * alpha_i) / _DeltaTime;
}


// Algorithm 3, lines 3-6: predicted density rho*_i (explicit Euler on Eq. 9),
// then kappa_i = (1/dt^2)(rho*_i - rho0) * alpha_i. Reuses the same alpha_i
// computed once per step by ComputeAlpha (paper's whole point: alpha_i is
// shared between both solvers since it only depends on positions).
[numthreads(NumThreads, 1, 1)]
void ComputePredictedDensityKappa(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ParticleCount) return;

    float3 position = _Positions[id.x].xyz;
    float3 velocity_i = _VelocitiesReadDF[id.x];
    float density_i = _Densities[id.x].x;
    float alpha_i = _Alphas[id.x];

    float sqrH = _SmoothingRadius * _SmoothingRadius;
    int3 centreCell = PositionToCellCoord(position, _SmoothingRadius);

    float drhoDt = 0.0; // Drho_i/Dt (Eq. 9), same form as divergence solver

    [unroll]
    for (int n = 0; n < 27; n++)
    {
        int3 cell = centreCell + CellOffsets[n];
        uint key = GetKey(HashCell(cell), _ParticleCount);
        uint start = SpatialOffsets[key];
        if (start == UINT_MAX) continue;

        for (uint j = start; j < _ParticleCount; j++)
        {
            uint cellKey = SpatialKeys[j];
            if (cellKey != key) break;
            if (j == id.x) continue;

            float3 otherPosition = _Positions[j].xyz;
            float3 offset = otherPosition - position;
            float sqrD = dot(offset, offset);
            if (sqrD > sqrH) continue;

            float dst = sqrt(sqrD);
            float3 dir = (dst > 0.0) ? (offset / dst) : float3(0.0, 1.0, 0.0);
            float3 gradW = DFSPH_GradW(dst, dir, _SmoothingRadius);

            float3 velocity_j = _VelocitiesReadDF[j];
            drhoDt += _Mass * dot(velocity_i - velocity_j, gradW);
        }
    }

    // rho*_i = rho_i + dt * Drho_i/Dt  (explicit Euler prediction, Sec 3.3)
    float predictedDensity = density_i + _DeltaTime * drhoDt;

    // Clamp density error to be non-negative: negative pressure (rho* < rho0)
    // would pull particles together, which is not physically meaningful for a
    // free surface and is commonly clamped to 0 in DFSPH implementations.
    float densityError = predictedDensity - _TargetDensity;

    _Kappas[id.x] = densityError * alpha_i / (_DeltaTime * _DeltaTime);
}

// Algorithm 3, line 7: same symmetric correction formula as
// ApplyDivergenceCorrection, but using the constant-density kappa_i from
// ComputePredictedDensityKappa above instead of the divergence kappa_i.
[numthreads(NumThreads, 1, 1)]
void ApplyDensityCorrection(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ParticleCount) return;

    float3 position = _Positions[id.x].xyz;
    float3 velocity_i = _VelocitiesReadDF[id.x];
    float density_i = _Densities[id.x].x;
    float kappa_i = _Kappas[id.x];

    float sqrH = _SmoothingRadius * _SmoothingRadius;
    int3 centreCell = PositionToCellCoord(position, _SmoothingRadius);

    float3 deltaV = float3(0.0, 0.0, 0.0);

    [unroll]
    for (int n = 0; n < 27; n++)
    {
        int3 cell = centreCell + CellOffsets[n];
        uint key = GetKey(HashCell(cell), _ParticleCount);
        uint start = SpatialOffsets[key];
        if (start == UINT_MAX) continue;

        for (uint j = start; j < _ParticleCount; j++)
        {
            uint cellKey = SpatialKeys[j];
            if (cellKey != key) break;
            if (j == id.x) continue;

            float3 otherPosition = _Positions[j].xyz;
            float3 offset = otherPosition - position;
            float sqrD = dot(offset, offset);
            if (sqrD > sqrH) continue;

            float dst = sqrt(sqrD);
            float3 dir = (dst > 0.0) ? (offset / dst) : float3(0.0, 1.0, 0.0);
            float3 gradW = DFSPH_GradW(dst, dir, _SmoothingRadius);

            float density_j = _Densities[j].x;
            float kappa_j = _Kappas[j];

            deltaV += _Mass * (kappa_i / density_i + kappa_j / density_j) * gradW;
        }
    }

    velocity_i -= _DeltaTime * deltaV;
    _VelocitiesWriteDF[id.x] = velocity_i;
}

// Algorithm 2, line 7: apply the symmetric pressure-force velocity correction
// using kappa_i / kappa_j already computed by ComputeDivergenceKappa above.
// Reads v* from _VelocitiesReadDF, writes corrected v* to _VelocitiesWriteDF
// (ping-pong, since this is Jacobi — every particle's update this sweep must
// be based on the same pre-sweep velocity snapshot, not a partially-updated one).
//
// One full Jacobi iteration = ComputeDivergenceKappa + ApplyDivergenceCorrection,
// dispatched back-to-back. C# calls this pair _JacobiIterations times, swapping
// which buffer is "read" and which is "write" each time (see PhysicsSystem3D.Simulate).
// The fixed iteration count replaces the paper's convergence-threshold while-loop,
// so no CPU readback of the average density-change rate is needed between iterations.
[numthreads(NumThreads, 1, 1)]
void ApplyDivergenceCorrection(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ParticleCount) return;

    float3 position = _Positions[id.x].xyz;
    float3 velocity_i = _VelocitiesReadDF[id.x];
    float density_i = _Densities[id.x].x;
    float kappa_i = _Kappas[id.x];

    float sqrH = _SmoothingRadius * _SmoothingRadius;
    int3 centreCell = PositionToCellCoord(position, _SmoothingRadius);

    float3 deltaV = float3(0.0, 0.0, 0.0);

    [unroll]
    for (int n = 0; n < 27; n++)
    {
        int3 cell = centreCell + CellOffsets[n];
        uint key = GetKey(HashCell(cell), _ParticleCount);
        uint start = SpatialOffsets[key];

        if (start == UINT_MAX) continue;

        for (uint j = start; j < _ParticleCount; j++)
        {
            uint cellKey = SpatialKeys[j];
            if (cellKey != key) break;
            if (j == id.x) continue;

            float3 otherPosition = _Positions[j].xyz;
            float3 offset = otherPosition - position;
            float sqrD = dot(offset, offset);

            if (sqrD > sqrH) continue;

            float dst = sqrt(sqrD);
            float3 dir = (dst > 0.0) ? (offset / dst) : float3(0.0, 1.0, 0.0);
            float3 gradW = DFSPH_GradW(dst, dir, _SmoothingRadius);

            float density_j = _Densities[j].x;
            float kappa_j = _Kappas[j];

            deltaV += _Mass * (kappa_i / density_i + kappa_j / density_j) * gradW;
        }
    }

    velocity_i -= _DeltaTime * deltaV;
    _VelocitiesWriteDF[id.x] = velocity_i;
}

// --- VISCOSITY HELPER ---
inline float3 ComputeViscosityContribution(float dst, float h, float mass, float3 velocity, float3 otherVelocity, float otherDensity)
{
    float viscLaplacian = CalculateViscosityWeight(dst, h);
    float3 velDiff = otherVelocity - velocity;
    
    return mass * (velDiff / otherDensity) * viscLaplacian;
}

// --- SURFACE TENSION HELPER ---
inline void ComputeSurfaceTensionContribution(float dst, float sqrD, float sqrH, float h, float mass, float3 offset, float otherDensity, inout float3 colorFieldGradient, inout float colorFieldLaplacian)
{
    float mOverRho = mass / otherDensity;
    float3 dir = (dst > 0.0001) ? (offset / dst) : float3(0.0, 1.0, 0.0);
    
    float gradScalar = CalculateSurfaceTensionGradientWeight(dst, sqrD, sqrH, h);
    colorFieldGradient += mOverRho * gradScalar * dir;

    float lapScalar = CalculateSurfaceTensionLaplacianWeight(sqrD, sqrH, h);
    colorFieldLaplacian += mOverRho * lapScalar;
}

[numthreads(NumThreads, 1, 1)]
void CalculateExternalForce(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ParticleCount) return;

    // 1. Read current state
    float3 position = _Positions[id.x].xyz;
    float3 velocity = _Velocities[id.x].xyz;
    float density = _Densities[id.x].x;
    
    // 2. Base Gravity & Interaction
    float3 gravityAccel = float3(0.0, _Gravity, 0.0);
    // [Insert your interaction logic here to modify gravityAccel]

    // 3. Setup Loop Variables
    float3 viscForce = float3(0.0, 0.0, 0.0);
    float3 colorFieldGradient = float3(0.0, 0.0, 0.0);
    float colorFieldLaplacian = 0.0;
    
    float sqrH = _SmoothingRadius * _SmoothingRadius;
    int3 centreCell = PositionToCellCoord(position, _SmoothingRadius);

    // 4. THE MODULAR SINGLE LOOP
    [unroll]
    for (int n = 0; n < 27; n++)
    {
        int3 cell = centreCell + CellOffsets[n];
        uint key = GetKey(HashCell(cell), _ParticleCount);
        uint start = SpatialOffsets[key];

        if (start == UINT_MAX) continue;
        
        for (uint j = start; j < _ParticleCount; j++)
        {
            uint cellKey = SpatialKeys[j];
            if (cellKey != key) break;
            if (j == id.x) continue;
            
            float3 otherPosition = _Positions[j].xyz;
            float3 offset = otherPosition - position;
            float sqrD = dot(offset, offset);
            
            if (sqrD > sqrH) continue;
            
            float dst = sqrt(sqrD);
            float otherDensity = _Densities[j].x;
            float3 otherVelocity = _Velocities[j].xyz;
            
            // --- MODULAR PHYSICS CALLS ---
            viscForce += ComputeViscosityContribution(dst, _SmoothingRadius, _Mass, velocity, otherVelocity, otherDensity);
            
            ComputeSurfaceTensionContribution(dst, sqrD, sqrH, _SmoothingRadius, _Mass, offset, otherDensity, colorFieldGradient, colorFieldLaplacian);
        }
    }

    // 5. Finalize Forces
    float3 surfaceForce = float3(0,0,0);
    float normalMag = length(colorFieldGradient);
    if (normalMag > _SurfaceTensionThreshold)
    {
        float3 surfaceNormal = colorFieldGradient / normalMag;
        surfaceForce = -_SurfaceTensionCoeff * colorFieldLaplacian * surfaceNormal;
    }

    viscForce *= _ViscosityCoeff;

    // 6. Integrate
    float3 totalForceAccel = (viscForce + surfaceForce) / density;
    velocity += (gravityAccel + totalForceAccel) * _DeltaTime;
    
    _Velocities[id.x] = float4(velocity, 0.0);
}

