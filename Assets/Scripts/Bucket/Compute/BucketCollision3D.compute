#pragma kernel ResolveBucketCollisions

static const float PI = 3.14159265f;

struct HoleGPU
{
    float type; float location; float radius;
    float width; float height; float angleDeg;
    float heightPos; float offsetX; float offsetY;
};

struct DividerGPU { float3 dir; float3 normal; };

RWStructuredBuffer<float3> _Positions;
RWStructuredBuffer<float3> _Velocities;
StructuredBuffer<HoleGPU> _Holes;
StructuredBuffer<DividerGPU> _Dividers;

uint _ParticleCount, _HoleCount, _DividerCount;
float _BottomRadius, _TopRadius, _BucketHeight;
float _WallThickness, _DividerHalfThickness, _ParticleRadius, _Restitution;
float4x4 _BucketWorldToLocal, _BucketLocalToWorld;

bool IsInSideHole(float3 pos, float currentRadius)
{
    float angleDeg = degrees(atan2(pos.z, pos.x));
    if (angleDeg < 0) angleDeg += 360.0;

    for (uint i = 0; i < _HoleCount; i++)
    {
        HoleGPU h = _Holes[i];
        if (h.location > 0.5) continue; 

        float angleDelta = abs(angleDeg - h.angleDeg);
        if (angleDelta > 180.0) angleDelta = 360.0 - angleDelta;

        float arcDist = radians(angleDelta) * currentRadius;
        float heightDist = pos.y - h.heightPos;

        if (h.type < 0.5) {
            float dist = sqrt(arcDist * arcDist + heightDist * heightDist);
            if (dist < h.radius) return true;
        } else {
            if (arcDist < h.width * 0.5 && abs(heightDist) < h.height * 0.5) return true;
        }
    }
    return false;
}

bool IsInBottomHole(float3 pos)
{
    for (uint i = 0; i < _HoleCount; i++)
    {
        HoleGPU h = _Holes[i];
        if (h.location < 0.5) continue; 

        float dx = pos.x - h.offsetX;
        float dz = pos.z - h.offsetY;

        if (h.type < 0.5) {
            if (sqrt(dx * dx + dz * dz) < h.radius) return true;
        } else {
            if (abs(dx) < h.width * 0.5 && abs(dz) < h.height * 0.5) return true;
        }
    }
    return false;
}

void ResolveFloor(inout float3 pos, inout float3 vel, float radialDist)
{
    if (radialDist > _BottomRadius) return; 
    float floorSurfaceY = _WallThickness + _ParticleRadius;

    if (pos.y > -_ParticleRadius && pos.y < floorSurfaceY)
    {
        if (!IsInBottomHole(pos)) {
            pos.y = floorSurfaceY;
            if (vel.y < 0.0) vel.y = -vel.y * _Restitution;
        }
    }
}

void ResolveWall(inout float3 pos, inout float3 vel, float radialDist, float currentOuterR)
{
    if (pos.y <= 0.0 || pos.y >= _BucketHeight) return;

    float currentInnerR = currentOuterR - _WallThickness;
    float allowedInnerDist = currentInnerR - _ParticleRadius;
    float allowedOuterDist = currentOuterR + _ParticleRadius;
    
    float catchRadius = currentOuterR + 1.0; 

    if (radialDist > allowedInnerDist && radialDist < catchRadius)
    {
        if (!IsInSideHole(pos, currentOuterR))
        {
            float2 dir2 = pos.xz / max(radialDist, 0.0001);
            float slope = (_TopRadius - _BottomRadius) / _BucketHeight;

            if (radialDist < currentInnerR + (_WallThickness * 0.5))
            {
                pos.xz = dir2 * allowedInnerDist;
                float3 normal = normalize(float3(-dir2.x, slope, -dir2.y));
                float normalVel = dot(vel, normal);
                if (normalVel < 0.0) vel -= normal * normalVel * (1.0 + _Restitution);
            }
            else
            {
                pos.xz = dir2 * allowedOuterDist;
                float3 normal = normalize(float3(dir2.x, -slope, dir2.y));
                float normalVel = dot(vel, normal);
                if (normalVel < 0.0) vel -= normal * normalVel * (1.0 + _Restitution);
            }
        }
    }
}

void ResolveDividers(inout float3 pos, inout float3 vel, float radialDist, float currentOuterR)
{
    if (pos.y <= _WallThickness || pos.y >= _BucketHeight || radialDist > currentOuterR) return;

    for (uint d = 0; d < _DividerCount; d++)
    {
        DividerGPU axis = _Dividers[d];
        float normalCoord = dot(float2(axis.normal.x, axis.normal.z), pos.xz);
        float dirCoord = dot(float2(axis.dir.x, axis.dir.z), pos.xz);
        
        if (dirCoord > -(_DividerHalfThickness + _ParticleRadius))
        {
            float penetration = (_DividerHalfThickness + _ParticleRadius) - abs(normalCoord);
            if (penetration > 0.0)
            {
                float pushSign = sign(normalCoord);
                if (pushSign == 0.0) pushSign = 1.0;

                pos += axis.normal * (penetration * pushSign);
                float normalVel = dot(vel, axis.normal) * pushSign;
                if (normalVel < 0.0) vel -= axis.normal * pushSign * normalVel * (1.0 + _Restitution);
            }
        }
    }
}

[numthreads(256, 1, 1)]
void ResolveBucketCollisions(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ParticleCount) return;

    float3 pos = mul(_BucketWorldToLocal, float4(_Positions[id.x], 1.0)).xyz;
    
    float absoluteMaxRadius = max(_TopRadius, _BottomRadius) + 5.0; 
    if (pos.y < -5.0 || pos.y > _BucketHeight + 5.0 || length(pos.xz) > absoluteMaxRadius) return;

    float3 vel = mul((float3x3)_BucketWorldToLocal, _Velocities[id.x]);
    float t = saturate(pos.y / max(_BucketHeight, 0.0001));
    float currentOuterR = lerp(_BottomRadius, _TopRadius, t);
    float radialDist = length(pos.xz);

    [unroll]
    for (int i = 0; i < 2; i++)
    {
        ResolveFloor(pos, vel, radialDist);
        ResolveWall(pos, vel, radialDist, currentOuterR);
        ResolveDividers(pos, vel, radialDist, currentOuterR);
        radialDist = length(pos.xz);
    }

    _Positions[id.x] = mul(_BucketLocalToWorld, float4(pos, 1.0)).xyz;
    _Velocities[id.x] = mul((float3x3)_BucketLocalToWorld, vel);
}